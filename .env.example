# Opcional. Sem estas variáveis o ReplayX usa o seu projeto Firebase (coffee-spark-ai-barista-e7a91).
# Copia para .env.local e preenche para usar outro projeto Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Pagamentos (ZumboPay) — só no servidor. Põe estas variáveis na Vercel (Settings → Environment Variables).
ZUMBOPAY_API_KEY=
ZUMBOPAY_MERCHANT_ID=
ZUMBOPAY_WALLET_ID=
ZUMBOPAY_WEBHOOK_SECRET=
# JSON da chave de serviço do Firebase (Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Contactos que aparecem nas páginas legais e no suporte (públicos)
# Nome do titular (por omissão: Major Group)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# app_id da Deriv (regista o teu em https://api.deriv.com/dashboard). Sem isto usa o público de testes (1089).
NEXT_PUBLIC_DERIV_APP_ID=
