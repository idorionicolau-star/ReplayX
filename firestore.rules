rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Plano (plan, subscriptionEndsAt, paidUntilMs): o dono só lê; só o servidor escreve.
    match /replayx_users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Pagamentos: o dono só lê; só o servidor escreve.
    match /replayx_users/{uid}/payments/{paymentId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Dados da app (layout, desenhos, sessões de replay, estratégias, alertas), guardados como JSON.
    match /replayx_users/{uid}/state/{key} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && key in ['settings', 'workspace', 'drawings', 'trading', 'strategies', 'alerts']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'savedAt'])
        && request.resource.data.data is string;
      allow delete: if isOwner(uid);
    }

    // Tudo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
